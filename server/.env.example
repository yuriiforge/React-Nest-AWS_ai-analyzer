# --- App Configuration ---
NODE_ENV=development
PORT=4000
# The URL of your Vite frontend for CORS settings
CLIENT_URL=http://localhost:5173

# --- Vector Database (Pinecone) ---
PINECONE_API_KEY=your_value
PINECONE_INDEX=your_value
# Match this with your index settings (e.g., 768, 1024, or 3072)
EMBEDDING_DIMENSIONS=your_value

# --- AI Models (Google Gemini) ---
GEMINI_API_KEY=your_value
GEMINI_CHAT_MODEL=your_value
GEMINI_EMBEDDING_MODEL=your_value

# --- AWS Infrastructure ---
AWS_REGION=your_value
AWS_ACCESS_KEY_ID=your_value
AWS_SECRET_ACCESS_KEY=your_value
AWS_S3_BUCKET=your_value
DYNAMODB_TABLE_NAME=your_value
AWS_STATE_MACHINE_ARN=your_value